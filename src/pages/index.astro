---
import Layout from '../layouts/Layout.astro';
import OSHeader from '../components/OSHeader.astro';
import HeroWindow from '../components/HeroWindow.astro';
import ServicesSection from '../components/ServicesSection.astro';
import { ProjectCalculator } from '../components/ProjectCalculator';
import TechStackSection from '../components/TechStackSection.astro';
import PortfolioSection from '../components/PortfolioSection.astro';
import { InteractiveTerminal } from '../components/InteractiveTerminal';
import { ContactSection } from '../components/ContactSection';
import OSFooter from '../components/OSFooter.astro';
---

<Layout
  title="Click — Web Corporativa & Software a la Medida ($3,000 USD Quality)"
  description="Estudio de ingeniería de software especializado en páginas web corporativas de alto impacto, plataformas a la medida y rendimiento extremo Zero Lag."
>
  <OSHeader />

  <main>
    <HeroWindow />
    <ServicesSection />

    <div class="container">
      <ProjectCalculator client:visible />
    </div>

    <TechStackSection />
    <PortfolioSection />

    <div class="container">
      <InteractiveTerminal client:visible />
      <ContactSection client:visible />
    </div>
  </main>

  <OSFooter />
</Layout>

<style>
  main {
    min-height: 100vh;
    padding-bottom: 20px;
  }
</style>
