---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="404: No encontrado — Click"
  description="La ruta solicitada no existe o ha sido movida."
  noindex={true}
>
  <main class="min-h-screen flex items-center justify-center p-6 bg-[var(--color-bg)]">
    <div class="flex flex-col items-center text-center max-w-sm gap-4">
      <img src="/logo.svg" alt="Click" class="object-contain" width="64" height="64" />
      <span class="font-mono text-xs font-bold text-[var(--color-brand)] bg-[var(--color-surface-high)] border border-[var(--color-border)] px-2.5 py-1 shadow-[2px_2px_0px_var(--color-border)]">
        404
      </span>
      <h1 class="text-2xl font-extrabold tracking-tight text-[var(--color-text)]">
        Página no encontrada
      </h1>
      <p class="text-sm text-[var(--color-text-muted)] mb-2">
        La ruta solicitada no existe o ha sido movida.
      </p>
      <a href="/" class="btn-primary">
        ← Volver al inicio
      </a>
    </div>
  </main>
</Layout>

