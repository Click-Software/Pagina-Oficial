---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="404: No encontrado — Click"
  description="La ruta solicitada no existe o ha sido movida."
  noindex={true}
>
  <main class="error-stage">
    <div class="error-card">
      <img src="/logo.svg" alt="Click" class="error-logo" width="64" height="64" />
      <span class="error-code">404</span>
      <h1 class="error-title">Página no encontrada</h1>
      <p class="error-desc">La ruta solicitada no existe o ha sido movida.</p>
      <a href="/" class="btn-primary">
        ← Volver al inicio
      </a>
    </div>
  </main>
</Layout>

<style>
  .error-stage {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .error-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 24rem;
    gap: 1rem;
  }

  .error-logo {
    object-fit: contain;
  }

  .error-code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-primary);
    background: var(--color-surface-container-high);
    border: 1px solid var(--text-on-surface);
    padding: 0.25rem 0.6rem;
    box-shadow: 2px 2px 0px #121212;
  }

  .error-title {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-on-surface);
  }

  .error-desc {
    font-size: 0.95rem;
    color: var(--text-on-surface-variant);
    margin-bottom: 0.5rem;
  }
</style>
