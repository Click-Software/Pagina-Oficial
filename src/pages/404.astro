---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="404: No encontrado — Click"
  description="Página no encontrada en el sitio oficial de Click."
  noindex={true}
>
  <main class="minimal-stage">
    <div class="brand-unit">
      <img src="/logo.svg" alt="Click" class="brand-logo" width="96" height="96" />
      <h1 class="brand-name">404</h1>
      <p class="brand-slogan">La ruta solicitada no existe o ha sido movida.</p>
      <a href="/" style="color: var(--text); font-weight: 700; text-decoration: underline; margin-top: 1rem; font-size: 0.9rem;">
        ← Volver al inicio
      </a>
    </div>
  </main>
</Layout>
