---
import '@/styles/global.css';
import SEOHead from '@/components/common/SEOHead.astro';
import { Font } from 'astro:assets';

export interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/logo.png" />

    <!-- InyecciÃ³n y precarga optimizada de fuentes con Astro Fonts API -->
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />


    <!-- SEO, Open Graph & Structured Data -->
    <SEOHead title={title} description={description} image={image} noindex={noindex} />
  </head>
  <body>
    <slot />
    <script>
      const motionItems = document.querySelectorAll<HTMLElement>(
        '.site-section > .container-stage, .portfolio-section__header, .portfolio-grid > *, .about-card, .team-card, .contact-form, .contact-channels'
      );
      const motionObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            motionObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -8% 0px' });

      motionItems.forEach((item, index) => {
        item.setAttribute('data-motion-reveal', '');
        item.style.transitionDelay = `${Math.min(index % 7, 6) * 60}ms`;
        motionObserver.observe(item);
      });
    </script>
  </body>
</html>
