---
import '@/styles/global.css';
import SEOHead from '@/components/common/SEOHead.astro';
import { Font } from 'astro:assets';

export interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/logo.png" />

    <!-- Inyección y precarga optimizada de fuentes con Astro Fonts API -->
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />


    <!-- SEO, Open Graph & Structured Data -->
    <SEOHead title={title} description={description} image={image} noindex={noindex} />
  </head>
  <body>
    <slot />
  </body>
</html>
