---
interface Props {
    title: string;
    description: string;
    image?: string;
    alt?: string;
}

const { title, description, image, alt = "" } = Astro.props;
---

<article class="about-card">
    <div class="card-media">
        <img src={image} alt={alt} loading="lazy" />
    </div>
    <div class="card-content">
        <h3 class="card-title">{title}</h3>
        <p class="card-description">{description}</p>
    </div>
</article>


<style>
    .about-card {
        display: flex;
        gap: 2rem;
        align-items: center;
        text-align: justify;
        background-color: var(--color-surface);
        border: 2.5px solid var(--color-border);
        box-shadow: 6px 6px 0px var(--color-border);
        padding: 2rem 2.5rem 2rem;
        height: 100%;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .card-media {
        flex-shrink: 0; 
        width: 100px;
        height: 100px;
        border: 2.5px solid var(--color-border);
    }

    .card-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        flex-shrink: 0; 
    }
    
    .card-content {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .card-title {
        font-size: 1.5rem;
        font-weight: 600;
        
    }
</style>