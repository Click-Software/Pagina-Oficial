---
interface Props {
    title: string;
    description: string;
    image?: string;
    imageAlt?: string;
    icon?: string;
    cta?: string;
    href?: string;
}

const {
    title,
    description,
    image,
    imageAlt = title,
    icon,
    cta = "Cotizar este servicio",
    href = "#contacto",
} = Astro.props;

const imageUrl = image || (icon ? `/assets/services/${icon}.svg` : "/logo.svg");
---

<article class="service-card group flex flex-col gap-4">
    <div class="mb-6 flex h-24 w-full items-center justify-center">
        <img
            src={imageUrl}
            alt={imageAlt}
            width="100"
            height="100"
            loading="lazy"
        />
    </div>

    <h3 class="mb-5 text-xl font-extrabold tracking-tight text-text sm:text-2xl">
        {title}
    </h3>

    <p class="mb-8 flex-1 text-sm leading-relaxed text-text-muted">
        {description}
    </p>

    <a href={href} class="btn-card mt-auto w-full max-w-[240px]">
        {cta}
    </a>
</article>

<style>
    .btn-card {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.65rem 1.25rem;
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--color-text);
        background-color: var(--color-surface);
        border: 2px solid var(--color-border);
        border-radius: 0.5rem;
        box-shadow: 3px 3px 0px var(--color-border);
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.1s ease, box-shadow 0.1s ease;
    }

    .btn-card:hover {
        transform: translate(1px, 1px);
        box-shadow: 2px 2px 0px var(--color-border);
    }

    .btn-card:active {
        transform: translate(3px, 3px);
        box-shadow: 0px 0px 0px var(--color-border);
    }

    .service-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        background-color: var(--color-surface);
        border: 2.5px solid var(--color-border);
        border-radius: 1.15rem;
        box-shadow: 6px 6px 0px var(--color-border);
        padding: 2.5rem 1.75rem 2rem;
        height: 100%;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .service-card:hover {
        transform: translateY(-4px);
        box-shadow: 8px 8px 0px var(--color-border);
    }
</style>