---
import { getCollection } from "astro:content";
import WindowFrame from "./WindowFrame.astro";
import TeamCard from "./TeamCard.astro";

const team = (await getCollection("team")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<section id="equipo" class="team-section">
  <div class="container-stage">
    <WindowFrame title="EQUIPO_TECNICO.EXE">
      <header class="team-section__header">
        <span class="team-section__eyebrow">quiénes construyen tu proyecto</span>
        <h2 class="team-section__title">El equipo detrás de Click</h2>
        <p class="team-section__subtitle">
          Cada persona en este roster es responsable directa de una parte del
          desarrollo. Así sabés exactamente con quién estás trabajando.
        </p>
      </header>

      <div class="team-grid">
        {
          team.map((member) => (
            <TeamCard 
              name={member.data.name}
              role={member.data.role}
              bio={member.data.bio}
              avatarSrc={member.data.avatar}
              initials={member.data.name
                .split(" ")
                .map((part) => part[0])
                .join("")
                .slice(0, 2)
                .toUpperCase()}
              accent={
                member.data.order % 3 === 2
                  ? "blue"
                  : member.data.order % 4 === 0
                  ? "yellow"
                  : "teal"
              }
            />
          ))
        }
      </div>
    </WindowFrame>
  </div>
</section>

<style>
  .team-section {
    padding: 64px 0;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .team-section__header {
    max-width: 48ch;
    margin-bottom: 32px;
  }

  .team-section__eyebrow {
    display: inline-block;
    margin-bottom: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    color: var(--color-brand);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .team-section__title {
    font-family: var(--font-sans);
    font-size: 32px;
    font-weight: 700;
    line-height: 40px;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-bottom: 12px;
  }

  .team-section__subtitle {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 24px;
    color: var(--color-text-muted);
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  @media (max-width: 1023px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .team-section {
      padding: 36px 0;
    }
    .team-section__title {
      font-size: 26px;
      line-height: 34px;
    }
    .team-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
