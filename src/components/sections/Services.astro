---
import { getCollection } from "astro:content";
import ServiceCard from "@/components/ui/ServiceCard.astro";

import corporateIcon from "@/assets/icons/icon-service-corporate.png";
import customIcon from "@/assets/icons/icon-service-custom.png";
import redesignIcon from "@/assets/icons/icon-service-redesign.png";

const services = await getCollection("services");
const sortedServices = [...services].sort((a, b) => (a.data.order ?? 1) - (b.data.order ?? 1));
const serviceImages: Record<string, string> = {
  "desarrollo-web-corporativo": corporateIcon.src,
  "aplicaciones-web-a-la-medida": customIcon.src,
  "optimizacion-rediseno-digital": redesignIcon.src,
};
---

<section id="servicios" class="site-section">
  <div class="container-stage flex flex-col items-center">
    <div class="w-full max-w-2xl mx-auto mb-14 text-center flex flex-col items-center">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight mb-4 text-center text-text">
        Nuestros Servicios
      </h2>
      <p class="text-base sm:text-lg text-text-muted leading-relaxed text-center">
        Soluciones digitales a la medida diseñadas para potenciar el crecimiento de tu empresa.
      </p>
    </div>

    <div class="w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 justify-items-center">
      {
        sortedServices.map((service) => (
          <div class="w-full max-w-sm flex">
            <ServiceCard
              title={service.data.title}
              description={service.data.description}
              cta={service.data.ctaLabel}
              href={`/?servicio=${service.data.serviceKey}#contacto`}
              image={serviceImages[service.id] || "/logo.svg"}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
