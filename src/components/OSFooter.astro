---
---

<footer class="os-footer-wrapper">
  <div class="container">
    <div class="os-window footer-window">
      <div class="window-titlebar inactive">
        <div class="window-title-text">
          <span class="badge-chip badge-teal">CLICK_OS_TERMINAL_DAEMON</span>
          <span>Click Software Studio — Official Web Platform</span>
        </div>
        <div class="window-controls">
          <button class="win-btn">_</button>
          <button class="win-btn">□</button>
          <button class="win-btn">✕</button>
        </div>
      </div>

      <div class="window-body footer-body">
        <div class="footer-grid">
          {/* Col 1 */}
          <div class="footer-col">
            <div class="brand-footer">
              <img src="/logo.svg" alt="Click Logo" class="footer-logo" width="32" height="32" />
              <span class="footer-title">Click</span>
            </div>
            <p class="slogan-text">
              Experiencias memorables en un solo click.
            </p>
            <p class="company-desc">
              Estudio de ingeniería de software especializado en sitios web corporativos y plataformas digitales a la medida de alto rendimiento.
            </p>
          </div>

          {/* Col 2 */}
          <div class="footer-col">
            <h4 class="footer-heading">SERVICIOS B2B</h4>
            <ul class="footer-links">
              <li><a href="#servicios">Web Corporativa Premium ($3,000)</a></li>
              <li><a href="#servicios">Software & MVP a la Medida</a></li>
              <li><a href="#servicios">Auditoría Performance Zero-Lag</a></li>
              <li><a href="#servicios">Design Systems Y2K Neobrutalistas</a></li>
            </ul>
          </div>

          {/* Col 3 */}
          <div class="footer-col">
            <h4 class="footer-heading">RECURSOS & HERRAMIENTAS</h4>
            <ul class="footer-links">
              <li><a href="#calculadora">Calculadora de Presupuesto ($3K)</a></li>
              <li><a href="#terminal">Consola CLI Interactiva</a></li>
              <li><a href="#stack">Arquitectura & Tech Stack</a></li>
              <li><a href="#casos">Casos de Éxito & Portafolio</a></li>
            </ul>
          </div>

          {/* Col 4 */}
          <div class="footer-col">
            <h4 class="footer-heading">TELEMETRÍA DE SISTEMA</h4>
            <div class="sunken-panel telemetry-footer">
              <div><span class="lbl">RUNTIME:</span> Bun v1.3+</div>
              <div><span class="lbl">FRAMEWORK:</span> Astro 5 + React 19</div>
              <div><span class="lbl">LIGHTHOUSE:</span> 100/100</div>
              <div><span class="lbl">REGION:</span> Cloudflare Global Edge</div>
              <div><span class="lbl">UPTIME:</span> 99.99%</div>
            </div>
          </div>
        </div>

        <div class="footer-bottom-bar">
          <div class="copy-text">
            © {new Date().getFullYear()} Click Software Studio. Todos los derechos reservados.
          </div>
          <div class="social-links">
            <a href="https://github.com/Click-Software" target="_blank" rel="noopener noreferrer" class="badge-chip badge-yellow">
              GITHUB
            </a>
            <a href="https://click.digitalandia.com" target="_blank" rel="noopener noreferrer" class="badge-chip badge-blue">
              CLICK.DIGITALANDIA.COM
            </a>
          </div>
        </div>
      </div>

      <div class="window-statusbar">
        <span>STATUS: DAEMON RUNNING OK</span>
        <span>ZERO LAG ARCHITECTURE GUARANTEED</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .os-footer-wrapper {
    padding-top: 24px;
    padding-bottom: 32px;
    background-color: transparent;
  }

  .footer-window {
    box-shadow: 6px 6px 0px var(--pixel-black);
  }

  .footer-body {
    padding: 28px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1.2fr;
    gap: 28px;
    margin-bottom: 24px;
  }

  .brand-footer {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .footer-title {
    font-size: 1.5rem;
    font-weight: 800;
  }

  .slogan-text {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--win-teal);
    margin-bottom: 8px;
  }

  .company-desc {
    font-size: 0.85rem;
    color: #52525b;
    line-height: 1.5;
  }

  .footer-heading {
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
    border-bottom: 2px solid var(--pixel-black);
    padding-bottom: 4px;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .footer-links a:hover {
    text-decoration: underline;
    color: var(--hyper-blue);
  }

  .telemetry-footer {
    font-family: var(--font-mono);
    font-size: 11px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .telemetry-footer .lbl {
    color: var(--win-teal);
    font-weight: bold;
  }

  .footer-bottom-bar {
    border-top: 2px solid var(--pixel-black);
    padding-top: 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.85rem;
  }

  .copy-text {
    font-weight: 600;
  }

  .social-links {
    display: flex;
    gap: 8px;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 550px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
