---
interface Props {
  title: string;
  client: string;
  problemSolved: string;
  image: string;
  imageAlt?: string;
  tags: string[];
  demoUrl?: string | undefined;
}

const {
  title,
  client,
  problemSolved,
  image,
  imageAlt = title,
  tags,
  demoUrl,
} = Astro.props;
---

<article class="portfolio-card">
  <button
    type="button"
    class="portfolio-card__media"
    data-lightbox-trigger
    data-image={image}
    data-alt={imageAlt}
    data-title={title}
    aria-label={`Ver vista previa ampliada de ${title}`}
  >
    <img src={image} alt={imageAlt} width="800" height="500" loading="lazy" />
    <span class="portfolio-card__zoom-hint">🔍 Vista previa ampliada</span>
  </button>

  <div class="portfolio-card__body">
    <span class="portfolio-card__client">{client}</span>
    <h3 class="portfolio-card__title">{title}</h3>
    <p class="portfolio-card__desc">{problemSolved}</p>

    <ul class="portfolio-card__tags">
      {tags.map((tag) => <li class="portfolio-card__tag">{tag}</li>)}
    </ul>

    {
      demoUrl && (
        <a
          href={demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-card"
        >
          Ver demostración
        </a>
      )
    }
  </div>
</article>

<style>
  .portfolio-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 2.5px solid var(--color-border);
    border-radius: 1rem;
    box-shadow: 6px 6px 0px var(--color-border);
    overflow: hidden;
    height: 100%;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .portfolio-card:hover {
    transform: translateY(-4px);
    box-shadow: 9px 9px 0px var(--color-border);
  }

  .portfolio-card__media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 8 / 5;
    padding: 0;
    margin: 0;
    border: none;
    border-bottom: 2.5px solid var(--color-border);
    cursor: zoom-in;
    background: none;
    overflow: hidden;
  }

  .portfolio-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.25s ease;
  }

  .portfolio-card__zoom-hint {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;
    background-color: rgba(18, 18, 18, 0.55);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .portfolio-card__media:hover .portfolio-card__zoom-hint,
  .portfolio-card__media:focus-visible .portfolio-card__zoom-hint {
    opacity: 1;
  }

  .portfolio-card__media:hover img {
    transform: scale(1.05);
  }

  .portfolio-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.5rem;
    gap: 0.5rem;
  }

  .portfolio-card__client {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-brand);
  }

  .portfolio-card__title {
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.3;
    color: var(--color-text);
    margin: 0;
  }

  .portfolio-card__desc {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    flex: 1;
    margin: 0;
  }

  .portfolio-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
  }

  .portfolio-card__tag {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    color: var(--color-text);
    background-color: var(--color-surface-high);
    border: 1.5px solid var(--color-border);
    border-radius: 0.35rem;
  }

  .btn-card {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.75rem;
    padding: 0.6rem 1.1rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text);
    background-color: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: 0.5rem;
    box-shadow: 3px 3px 0px var(--color-border);
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }

  .btn-card:hover {
    transform: translate(1px, 1px);
    box-shadow: 2px 2px 0px var(--color-border);
  }
</style>
