---
---

<section class="hero-section container">
  <div class="os-window hero-window">
    {/* Window Title Header */}
    <div class="window-titlebar">
      <div class="window-title-text">
        <span class="badge-chip badge-yellow">CLICK_CORP_OS.EXE</span>
        <span>Estudio de Desarrollo Web Corporativo & Software Premium</span>
      </div>
      <div class="window-controls">
        <button class="win-btn" title="Minimize">_</button>
        <button class="win-btn" title="Maximize">□</button>
        <button class="win-btn" title="Close">✕</button>
      </div>
    </div>

    {/* Hero Content */}
    <div class="window-body hero-body">
      <div class="hero-grid">
        <div class="hero-left">
          <div class="badge-group">
            <span class="badge-chip badge-teal">🚀 AGENCIA B2B DIGITAL</span>
            <span class="badge-chip badge-green">⚡ LIGHTHOUSE 100/100</span>
            <span class="badge-chip badge-blue">🔒 CIBERSEGURIDAD B2B</span>
          </div>

          <h1 class="hero-headline">
            Transformamos marcas con <span class="highlight-yellow">Webs Corporativas</span> y <span class="highlight-blue">Software a la Medida</span>.
          </h1>

          <p class="hero-subtext">
            Diseño Neobrutalista Y2K, ingeniería sin concesiones y velocidad de carga instantánea (Zero Lag). Creamos plataformas web de clase mundial que posicionan a tu empresa en la cima de su industria.
          </p>

          <div class="hero-actions">
            <a href="#calculadora" class="btn btn-primary btn-lg">
              CALCULAR MI PROYECTO ($3,000) →
            </a>
            <a href="#servicios" class="btn btn-secondary btn-lg">
              EXPLORAR SERVICIOS
            </a>
          </div>

          <div class="hero-guarantees">
            <div class="guarantee-item">
              <span class="check-icon">✓</span>
              <span>Código Limpio & Tipado Estricto (TypeScript)</span>
            </div>
            <div class="guarantee-item">
              <span class="check-icon">✓</span>
              <span>Despliegue Global Cloudflare Edge Network</span>
            </div>
            <div class="guarantee-item">
              <span class="check-icon">✓</span>
              <span>Soporte & Mantenimiento Garantizado</span>
            </div>
          </div>
        </div>

        <div class="hero-right">
          <div class="sunken-panel metrics-box">
            <div class="metrics-header">
              <span class="mono title">SYSTEM_BENCHMARKS.LOG</span>
              <span class="status-dot"></span>
            </div>

            <div class="metrics-grid">
              <div class="metric-card">
                <div class="metric-value">100/100</div>
                <div class="metric-label">Lighthouse Score</div>
              </div>
              <div class="metric-card">
                <div class="metric-value">0.12s</div>
                <div class="metric-label">Tiempo de Carga</div>
              </div>
              <div class="metric-card">
                <div class="metric-value">0 ms</div>
                <div class="metric-label">Total Blocking Time</div>
              </div>
              <div class="metric-card">
                <div class="metric-value">100%</div>
                <div class="metric-label">Seguridad & SEO</div>
              </div>
            </div>

            <div class="code-preview">
              <div class="code-header">
                <span>// INSTANT DEV-VIZZ FEATURE</span>
              </div>
              <pre class="code-block"><code>{`const agency = new ClickSoftwareStudio({
  quality: "EXCELLENCE_3000_USD",
  performance: "ZERO_LAG",
  architecture: "NEOBRUTALIST_Y2K",
  satisfaction: 1.00
});

await agency.deployYourProject();`}</code></pre>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Window Statusbar */}
    <div class="window-statusbar">
      <span>STATE: READY FOR DISRUPTION</span>
      <span>ESTUDIO PROFESIONAL • EXPERIENCIAS MEMORABLES EN UN SOLO CLICK</span>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: 28px;
    padding-bottom: 28px;
  }

  .hero-window {
    box-shadow: 8px 8px 0px var(--pixel-black);
  }

  .hero-body {
    padding: 32px;
    background-color: var(--pure-white);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 32px;
    align-items: center;
  }

  .badge-group {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .hero-headline {
    font-size: 2.5rem;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
    line-height: 1.15;
  }

  .highlight-yellow {
    background-color: var(--action-yellow);
    padding: 2px 8px;
    border: 2px solid var(--pixel-black);
    box-shadow: 2px 2px 0px var(--pixel-black);
    display: inline-block;
  }

  .highlight-blue {
    background-color: var(--hyper-blue);
    color: var(--pure-white);
    padding: 2px 8px;
    border: 2px solid var(--pixel-black);
    box-shadow: 2px 2px 0px var(--pixel-black);
    display: inline-block;
  }

  .hero-subtext {
    font-size: 1.1rem;
    color: #2c2b28;
    margin-bottom: 24px;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
  }

  .hero-guarantees {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .guarantee-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .check-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    background-color: var(--win-teal);
    color: white;
    font-size: 11px;
    font-weight: bold;
    border: 1px solid var(--pixel-black);
  }

  /* Right Side Metrics Box */
  .metrics-box {
    background-color: var(--chassis-gray);
    border: var(--border-heavy);
    padding: 16px;
  }

  .metrics-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: bold;
    font-size: 12px;
    margin-bottom: 12px;
    padding-bottom: 6px;
    border-bottom: var(--border-thick);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 16px;
  }

  .metric-card {
    background-color: var(--pure-white);
    border: var(--border-thick);
    padding: 12px;
    text-align: center;
    box-shadow: 2px 2px 0px var(--pixel-black);
  }

  .metric-value {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--win-teal);
  }

  .metric-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--pixel-black);
    text-transform: uppercase;
  }

  .code-preview {
    background-color: var(--pixel-black);
    border: var(--border-thick);
    padding: 12px;
    color: var(--terminal-green);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .code-header {
    color: var(--action-yellow);
    font-size: 10px;
    margin-bottom: 6px;
    border-bottom: 1px dashed #444;
    padding-bottom: 4px;
  }

  .code-block {
    margin: 0;
    overflow-x: auto;
  }

  @media (max-width: 992px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .hero-headline {
      font-size: 1.85rem;
    }
    .hero-body {
      padding: 20px;
    }
  }
</style>
